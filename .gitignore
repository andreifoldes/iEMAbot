/.idea/
/.vscode/
/dist/
/node_modules/
/esmira/
/src/test/backend/data_folder/
/.phpunit.result.cache
/src/test/phpunit-9.5.21.phar
.php-cs-fixer.cache

# Test artifacts (Playwright MCP screenshots, ad-hoc root screenshots)
/.playwright-mcp/
/*.png
/tools/pvt/_pvt_cursor_shots/

# Claude Code session logs & local tooling config (kept out of version control).
# settings.local.json stores every "don't ask again" command verbatim, including any
# password or token typed into it, so it is ignored at every depth, not just the root.
**/.claude/logs/
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock
**/.claude/*.local.*
# Other coding-agent transcripts and local state
**/.specstory/
**/.aider*
**/.cursor/
**/.gemini/
/skills-lock.json
/.mcp.json
/DESIGN.md

# Local-only Android test-build tooling (version counter, Drive upload)
android-app/scripts/*.local.sh
android-app/.test-build-number
android-app/.last-shipped-hash
android-app/.ship.lock
android-app/ship-test.log

# Local agent tooling (not part of the product)
/.agents/

# Signing keystores (never commit)
*.jks
*.keystore

# Local-only notes and project instructions
/notes.md
/CLAUDE.md

# Computed at docs build time by website/scripts/fork-stats.mjs
/website/src/generated/

# Secrets and credentials (never commit; use environment variables or CI secrets).
# The translation service API token (Crowdin) lives in a local .env.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
credentials.json
*-oauth.json

# Collected participant data and the SQLite store (esmira_data/iemabot.sqlite and its WAL files)
esmira_data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
