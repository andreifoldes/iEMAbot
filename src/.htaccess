php_value post_max_size 300M
php_value upload_max_filesize 300M
RewriteEngine On


# to fallback study		www.example.com/1234-KEY-f:FALLBACK
#RewriteRule ^(\d+)-([a-zA-Z][a-zA-Z0-9]+)-f:([0-9a-zA-Z+/=]+)$ index.php?key=$2#fallbackAppInstall,id:$1,fromUrl:$3 [NC,L,QSA]

# to study				www.example.com/1234
RewriteRule ^(\d+)$ index.php?id=$1 [NC,L,QSA]

# to study				www.example.com/KEY
RewriteRule ^([a-zA-Z][a-zA-Z0-9]+)$ index.php?key=$1 [NC,L,QSA]

# to study				www.example.com/1234-KEY
RewriteRule ^(\d+)-([a-zA-Z][a-zA-Z0-9]+)$ index.php?id=$1&key=$2 [NC,L,QSA]


# to app instructions	www.example.com/app-1234
RewriteRule ^app-(\d+)$ index.php?id=$1&app_install [NC,L,QSA]

# to app instructions	www.example.com/app-KEY
RewriteRule ^app-([a-zA-Z][a-zA-Z0-9]+)$ index.php?key=$1&app_install [NC,L,QSA]

# to app instructions	www.example.com/app-1234-KEY
RewriteRule ^app-(\d+)-([a-zA-Z][a-zA-Z0-9]+)$ index.php?id=$1&key=$2&app_install [NC,L,QSA]

# to fallback app instructions www.example.com/fallback-1234-FaLlBaCc=
RewriteRule ^fallback-(\d+)-([a-zA-Z0-9+\/=]+)$ index.php?id=$1&from_url=$2 [NC,L,QSA]

# to fallback app instructions www.example.com/fallback-1234-KEY-FaLlBaCc=
RewriteRule ^fallback-(\d+)-([a-zA-Z][a-zA-Z0-9]+)-([a-zA-Z0-9+\/=]+)$ index.php?id=$1&key=$2&from_url=$3 [NC,L,QSA]


# to questionnaire		www.example.com/survey-12345
RewriteRule ^survey-(\d+)$ index.php?qid=$1 [NC,L,QSA]

# to questionnaire		www.example.com/survey-12345-KEY
RewriteRule ^survey-(\d+)-([a-zA-Z][a-zA-Z0-9]+)$ index.php?qid=$1&key=$2 [NC,L,QSA]


# Fallback in case we ever want to replace the php backend:
RewriteRule ^api/([^.]+)$ api/$1.php [NC,L,QSA]

# Apache hides the Authorization header from PHP by default. wearables_webhook.php needs it: Google Health
# sends the subscriber secret there. Hand it to PHP as HTTP_AUTHORIZATION (REDIRECT_HTTP_AUTHORIZATION on an
# internal redirect, which the script also accepts).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]


# ---------------------------------------------------------------------------------------------------------------
# Security headers for every response from this folder: PHP pages, the API, static files and the PWA (/pwa/).
# Needs mod_headers (the Dockerfile enables it). HSTS is NOT set here: TLS ends at a reverse proxy, which must send
# it (website/docs/deployment/security-headers.md).
# test/backend/SecurityHeadersTest.php checks this block, so change both together.
# TODO(security): (1) turn the report-only policy below into an enforcing one once its violations have been watched;
#   nothing collects reports yet (no report-uri / report-to endpoint). (2) HSTS at the reverse proxy. (3) The /webapp/
#   task pages are served by the proxy, outside this folder, and need their own headers.
# ---------------------------------------------------------------------------------------------------------------
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	
	# Clickjacking: nobody embeds the admin pages or the PWA, the cognitive tasks are embedded BY the PWA, not the other way
	# around. This is the only enforcing CSP directive (frame-ancestors is ignored in a report-only policy). X-Frame-Options
	# is the same rule for browsers without CSP2.
	Header always set Content-Security-Policy "frame-ancestors 'self'"
	Header always set X-Frame-Options "SAMEORIGIN"
	
	# REPORT-ONLY: the browser logs violations (dev tools console) but blocks nothing. Do not turn it into
	# Content-Security-Policy before the violations have been watched (tracker item 9).
	# Why each source: blob: = plugin code is imported from an object URL (Requests.ts) and recordings are played from blobs;
	# data: = inlined icons; raw.githubusercontent.com / api.github.com / kl-psychological-methodology.github.io = the admin's
	# "about", update check and blog feed; https: images = pictures in the blog feed and in study texts; frame-src https: =
	# the PWA shows a study's cognitive task (any https page a researcher names) in an iframe; style-src 'unsafe-inline' =
	# React/Mithril style attributes and index_nojs.php.
	Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://raw.githubusercontent.com https://api.github.com https://kl-psychological-methodology.github.io; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
