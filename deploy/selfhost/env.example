# install.sh writes this as .env (this file only explains it). Run `docker compose up -d` after changing it.

# The server's public name. Point its DNS A/AAAA record at this machine before installing.
DOMAIN=ema.example.org
# Receives certificate expiry notices and identifies this server to browser push services.
ACME_EMAIL=you@example.org
# The name given to the first admin account.
ADMIN_ACCOUNT=admin
# The address participants use. Everything that depends on the server's address follows from it.
PUBLIC_URL=https://ema.example.org

# Which image to run. `update.sh 3.7.31` pins a version; `update.sh latest` goes back to following releases.
IEMABOT_IMAGE=ghcr.io/andreifoldes/iemabot
IEMABOT_VERSION=latest

# Caddyfile: Caddy gets its own HTTPS certificate on ports 80 and 443.
# Caddyfile.behind-proxy: another web server handles HTTPS and forwards everything to HTTP_BIND.
CADDYFILE=Caddyfile
HTTP_BIND=80
HTTPS_BIND=443

# How many backups backup.sh keeps.
BACKUP_KEEP=7
